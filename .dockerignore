# Keep the build context small and free of machine-specific state (see Dockerfile).
.git
.github
.claude
node_modules
.cache
.venv*
**/__pycache__
test
logs
*.log
docs/img
# the image needs only the research JSON tables (server/sim/nodeData.js fallback), not the notes
docs/research/*.md
# mod build: ship all game art/assets inside the image (they are committed to git, see .gitignore notes)
# public/assets  <- intentionally NOT ignored for this mod deploy
# generated from node_modules inside the image
public/vendor
scripts/service.env.cmd
.DS_Store
Thumbs.db
.env
.env.*
